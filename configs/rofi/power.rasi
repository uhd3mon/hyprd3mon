/* hyprd3mon power menu: compact centred glass list.
   Used by ~/.local/bin/hyprd3mon-power (rofi -dmenu). The confirm
   step reuses this theme with a 2-line list and a message. */

configuration {
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@import "d3mon.rasi"

window {
    location:         center;
    anchor:           center;
    width:            300px;
    background-color: @glass;
    border:           1px;
    border-color:     @line2;
    border-radius:    16px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  0;
    padding:  8px 0 0;
}

/* No search field: a quiet tracked label + the user. */
inputbar {
    children: [ prompt, textbox-user ];
    padding:  12px 20px 8px;
}

prompt {
    font:       "JetBrainsMono Nerd Font Bold 9";
    text-color: @dim;
}

textbox-user {
    expand:           true;
    str:              "d3mon";
    horizontal-align: 1;
    font:             "JetBrainsMono Nerd Font 9";
    text-color:       @faint;
}

message {
    padding: 2px 20px 6px;
}

textbox {
    text-color: @ink;
}

listview {
    lines:        4;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    cycle:        true;
    spacing:      4px;
    padding:      6px 10px 10px;
}

element {
    children:      [ element-text ];
    padding:       10px 12px;
    border:        1px;
    border-color:  transparent;
    border-radius: 11px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @ink;
}

element selected.normal {
    background-color: @accent-soft;
    border-color:     @accent;
    text-color:       @ink;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @bad;
}

element selected.urgent {
    background-color: @bad-soft;
    border-color:     @bad;
    text-color:       @bad;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    cursor:         inherit;
}
