/* hyprd3mon app launcher: centred dark glass panel, search on top.
   Run: rofi -show drun -theme ~/.config/rofi/launcher.rasi */

configuration {
    modi:                "drun";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        "";
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

@import "d3mon.rasi"

window {
    location:         center;
    anchor:           center;
    width:            620px;
    background-color: @glass;
    border:           1px;
    border-color:     @line2;
    border-radius:    16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  0;
    padding:  0;
}

inputbar {
    children:     [ prompt, entry, textbox-brand ];
    spacing:      14px;
    padding:      20px 22px;
    border:       0 0 1px 0;
    border-color: @line;
}

prompt {
    text-color:     @accent;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search apps";
    placeholder-color: @dim;
    cursor:            text;
    vertical-align:    0.5;
}

textbox-brand {
    expand:         false;
    str:            "d3mon";
    text-color:     @faint;
    vertical-align: 0.5;
}

listview {
    lines:        7;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    cycle:        true;
    spacing:      4px;
    padding:      10px;
}

element {
    children:      [ element-icon, element-text ];
    spacing:       14px;
    padding:       9px 12px;
    border:        1px;
    border-color:  transparent;
    border-radius: 11px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @ink;
}

element selected.normal,
element selected.active {
    background-color: @accent-soft;
    border-color:     @accent;
    text-color:       @ink;
}

element-icon {
    size:   28px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    cursor:         inherit;
}

message {
    padding: 0 22px 14px;
}

textbox {
    text-color: @dim;
}
